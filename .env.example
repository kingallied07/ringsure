# Telegram Bot API token used by /api/pilot to send new lead notifications.
TELEGRAM_BOT_TOKEN=your-bot-token-here

# The chat that receives notifications. Message your bot once, then run
# `npm run chat-id` to see the ID (see README for details).
TELEGRAM_CHAT_ID=your-chat-id-here

# Public URL of this deployment, used for Retell/Twilio webhooks.
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app

# Retell voice agent (one brain for every business).
RETELL_API_KEY=your-retell-api-key
RETELL_VOICE_ID=11labs-Adrian
RETELL_VOICE_MODEL=eleven_flash_v2_5

# The text model (brain). Retell supports claude-5.5-haiku, gpt-4.1-mini, tell-1, etc.
RETELL_MODEL=claude-5.5-haiku
RETELL_ANALYSIS_MODEL=claude-5.5-haiku

# Twilio (UK numbers and inbound call routing).
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token

# Owner desk access. Generate the hash with `npm run owner:password -- 'your-password'`.
OWNER_PASSWORD_HASH=scryptSaltHex:scryptHashHex
OWNER_SESSION_SECRET=a-long-random-string

# Signs the per-call tenant context used by the knowledge retrieval tool.
CALL_CONTEXT_SECRET=a-long-random-string

# Optional: a real, naturally-voiced sample recording for the marketing site.
NEXT_PUBLIC_SAMPLE_AUDIO_URL=
